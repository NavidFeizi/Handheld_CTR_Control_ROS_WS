# colcon build artifacts (workspace root)
/build/
/install/
/log/

# Python bytecode
__pycache__/
*.pyc

# Generated at build time by lib_robot's dcfgen POST_BUILD step
src/robot/lib_robot/config/master.dcf
src/robot/lib_robot/config/master.bin

# Recorder output sessions (runtime data; historical sessions remain tracked)
/Output_Files/

# Editor state — .vscode/tasks.json is tracked as the default build task
.vscode/*
!.vscode/tasks.json

# Qt Creator / CMake local state
CMakeLists.txt.user
