<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc</name>
  <version>1.0.0</version>
  <description>QP-based model-predictive controller for task-space tracking of the
  handheld CTR, linearizing the PINN each step and solving with a warm-started
  OSQP.</description>
  <maintainer email="nfeizi@uwo.com">navid</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>interfaces</depend>
  <depend>ctr_kinematics_pinn</depend>
  <depend>ctr_common</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
